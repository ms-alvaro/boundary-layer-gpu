!=======================================================================
! les_mod.cuf — subgrid-scale (LES) eddy viscosity for the CUDA port.
!
! Reference provenance
! --------------------
! Port of subgrid.f90: compute_eddy_viscosity dispatch, sgs_Smagorinsky
! (LES = 1) and compute_Sij. Loop bodies transcribed VERBATIM (same
! expressions, same operation order; d0 literals -> _dp) per
! docs/CUDA_PORT_DESIGN.md. The dynamic models (LES = 2/3) are staged
! separately.
!
! Layout and semantics
! --------------------
! * nu_t lives at cell centers, array (nxg, nyg, nzg) like the
!   reference's (nxg, nyg, nzm+2). Only the interior
!   (2:nxg-1, 2:nyg-1, 2:nzg-1) is ever written; all ghost/edge values
!   stay ZERO — the reference never exchanges or periodicizes nu_t
!   ghosts (allocation-zero is the de-facto BC), and the RHS reads the
!   zeros at k = 1/nzg exactly as the reference does.
! * The Smagorinsky prefactor (Cs*Delta*f)^2 depends only on j: it is
!   precomputed ONCE on the host with the reference's exact expressions.
!   The van-Driest damping branch is DEAD CODE in the reference:
!   initialization.f90:513 hard-overrides Dirichlet_nu_t = 0 after the
!   input parse ("Never use Dirichlet for nu_t"), so f = 1 always; the
!   port mirrors the override in les_allocate.
! * avg_nu_t: wall-parallel average per j over the LOCAL interior
!   (the reference does no MPI reduction here — per-rank averages),
!   summed in the reference's memory order (i fastest, then k) by a
!   one-thread-per-j kernel, then clipped and ghost-extended on the
!   host (apply_Dirichlet_bc_y/apply_Neumann_bc_y, id = 2 semantics).
!   In this port avg_nu_t feeds only the wall models (the cufft-path
!   pressure solve — the port's semantic reference — has no bc_1/bc_2
!   eddy-viscosity term).
!
! Driver contract: les_allocate() after grids; compute_eddy_viscosity()
! once per RK substep BEFORE that substep's RHS, on the current fields
! (substep 1: the step's base state — same hook point as the Lund
! inflow update). les_nut_to_host() refreshes the host mirror for
! statistics/snapshots at gated steps only.
!=======================================================================
module les_mod

  use precision_mod, only: dp, ceil_div
  use param_mod,     only: nu, dPdx, LES_model, Dirichlet_nu_t
  use grid_mod,      only: nx, ny, nz, nxg, nyg, nzg, x, y, z, xg, yg, zg, &
                           dx, dz, x_d, y_d, z_d, xg_d, yg_d, zg_d
  use field_mod,     only: U_d, V_d, W_d
  use cudafor

  implicit none
  private

  public :: les_allocate
  public :: compute_eddy_viscosity
  public :: les_nut_to_host

  ! eddy viscosity at cell centers: device + host mirror (stats/snapshots)
  real(dp), device, allocatable, public :: nu_t_d(:,:,:)
  real(dp),         allocatable, public :: nu_t(:,:,:)

  ! wall-parallel average of nu_t (host column; reference avg_nu_t(1,j,1))
  real(dp), allocatable, public :: avg_nu_t(:)

  ! edge-located off-diagonal Sij scratch (components 4, 5, 6)
  real(dp), device, allocatable :: S4e_d(:,:,:), S5e_d(:,:,:), S6e_d(:,:,:)

  ! per-j Smagorinsky prefactor (Cs*Delta*f)^2 and its device copy
  real(dp), allocatable         :: coef_smag(:)
  real(dp), device, allocatable :: coef_smag_d(:)

  ! device buffer for the per-j averages
  real(dp), device, allocatable :: avg_nu_t_d(:)

contains

  !--------------------------------------------------------------------
  ! les_allocate — allocate + zero all LES state; precompute the
  ! Smagorinsky prefactor column (sgs_Smagorinsky lines: Cs = 0.11,
  ! utau_t = dPdx**0.5, van-Driest f, Delta = (dx*dz*dy_j)^(1/3)).
  !--------------------------------------------------------------------
  subroutine les_allocate()

    integer  :: j
    real(dp) :: Cs, utau_t, f, Delta

    if (LES_model <= 0) return

    ! Never use Dirichlet for nu_t (reference initialization.f90:513
    ! hard-overrides the parsed 'nutBC' AFTER read_input_parameters —
    ! the input key is dead; the van-Driest damping branch never runs)
    Dirichlet_nu_t = 0

    allocate( nu_t_d(nxg, nyg, nzg) );  nu_t_d = 0.0_dp
    allocate( nu_t  (nxg, nyg, nzg) );  nu_t   = 0.0_dp
    allocate( S4e_d(nxg, nyg, nzg) );   S4e_d  = 0.0_dp
    allocate( S5e_d(nxg, nyg, nzg) );   S5e_d  = 0.0_dp
    allocate( S6e_d(nxg, nyg, nzg) );   S6e_d  = 0.0_dp
    allocate( avg_nu_t(nyg) );          avg_nu_t = 0.0_dp
    allocate( avg_nu_t_d(nyg) );        avg_nu_t_d = 0.0_dp
    allocate( coef_smag(nyg) );         coef_smag = 0.0_dp

    ! Smagorinsky constant coefficient (reference: Cs = 0.11d0)
    Cs = 0.11_dp

    ! utau from pressure gradient (reference: utau_t = dPdx**0.5d0)
    utau_t = dPdx**0.5_dp

    do j = 2, nyg-1
       if ( j < nyg/2 ) then
          f = 1.0_dp - exp( -( yg(j)-y(1)  )/25.0_dp/(nu/utau_t) )
       else
          f = 1.0_dp - exp( -( y(ny)-yg(j) )/25.0_dp/(nu/utau_t) )
       end if
       if ( Dirichlet_nu_t == 0 ) f = 1.0_dp
       Delta        = ( dx*dz*( y(j) - y(j-1) ) )**(1.0_dp/3.0_dp)
       coef_smag(j) = ( (Cs*Delta*f)**2.0_dp )
    end do

    allocate( coef_smag_d(nyg) )
    coef_smag_d = coef_smag

  end subroutine les_allocate

  !--------------------------------------------------------------------
  ! compute_eddy_viscosity — subgrid.f90 dispatch. Call once per RK
  ! substep before the RHS, with the substep's base fields in U_d/V_d/W_d.
  !--------------------------------------------------------------------
  subroutine compute_eddy_viscosity()

    if     ( LES_model == 1 ) then
       call sgs_smagorinsky_gpu()
    elseif ( LES_model == 2 .or. LES_model == 3 ) then
       stop 'LES = 2/3 (dynamic Smagorinsky) not yet wired in the CUDA port'
    end if

  end subroutine compute_eddy_viscosity

  !--------------------------------------------------------------------
  ! sgs_smagorinsky_gpu — sgs_Smagorinsky + compute_Sij as two kernels
  ! plus the per-j average.
  !--------------------------------------------------------------------
  subroutine sgs_smagorinsky_gpu()

    type(dim3) :: tb, gr
    integer    :: j

    tb = dim3(64, 4, 1)

    ! off-diagonal Sij at cell edges (compute_Sij second loop nest,
    ! i,j,k = 2..n*g)
    gr = dim3( ceil_div(nxg-1, 64), ceil_div(nyg-1, 4), nzg-1 )
    call k_sij_edges<<<gr, tb>>>(S4e_d, S5e_d, S6e_d, U_d, V_d, W_d, &
         x_d, y_d, z_d, xg_d, yg_d, zg_d, nx, ny, nz, nxg, nyg, nzg)
    call debug_check('k_sij_edges')

    ! diagonal Sij + edge->center average + |S| + nu_t (interior)
    gr = dim3( ceil_div(nxg-2, 64), ceil_div(nyg-2, 4), nzg-2 )
    call k_smag_nut<<<gr, tb>>>(nu_t_d, S4e_d, S5e_d, S6e_d, &
         U_d, V_d, W_d, coef_smag_d, x_d, y_d, z_d, &
         nx, ny, nz, nxg, nyg, nzg)
    call debug_check('k_smag_nut')

    ! wall-parallel average per j (reference memory order: i, then k)
    call k_avg_nut<<< ceil_div(nyg-2, 64), 64 >>>(avg_nu_t_d, nu_t_d, &
         nxg, nyg, nzg)
    call debug_check('k_avg_nut')

    avg_nu_t = avg_nu_t_d

    ! clipping negative values (reference: on the average only)
    do j = 1, nyg
       avg_nu_t(j) = max( avg_nu_t(j), 0.0_dp )
    end do

    ! ghost rows (apply_Dirichlet_bc_y / apply_Neumann_bc_y, id = 2)
    if ( Dirichlet_nu_t == 1 ) then
       avg_nu_t(1)   = -avg_nu_t(2)
       avg_nu_t(nyg) = -avg_nu_t(nyg-1)
    else
       avg_nu_t(1)   = avg_nu_t(2)
       avg_nu_t(nyg) = avg_nu_t(nyg-1)
    end if

  end subroutine sgs_smagorinsky_gpu

  !--------------------------------------------------------------------
  ! les_nut_to_host — refresh the host mirror (gated steps only).
  !--------------------------------------------------------------------
  subroutine les_nut_to_host()
    if (LES_model > 0) nu_t = nu_t_d
  end subroutine les_nut_to_host

  !--------------------------------------------------------------------
  ! k_sij_edges — compute_Sij off-diagonal loop (edge locations):
  !   Sij4 = 0.5*( (U(i-1,j,k)-U(i-1,j-1,k))/(yg(j)-yg(j-1))
  !              + (V(i,j-1,k)-V(i-1,j-1,k))/(xg(i)-xg(i-1)) )
  !   Sij5 = 0.5*( (U(i-1,j,k)-U(i-1,j,k-1))/(zg(k)-zg(k-1))
  !              + (W(i,j,k-1)-W(i-1,j,k-1))/(xg(i)-xg(i-1)) )
  !   Sij6 = 0.5*( (V(i,j-1,k)-V(i,j-1,k-1))/(zg(k)-zg(k-1))
  !              + (W(i,j,k-1)-W(i,j-1,k-1))/(yg(j)-yg(j-1)) )
  ! for i,j,k = 2..nxg/nyg/nzg.
  !--------------------------------------------------------------------
  attributes(global) subroutine k_sij_edges(S4, S5, S6, U, V, W, &
       x, y, z, xg, yg, zg, nx, ny, nz, nxg, nyg, nzg)
    integer, value :: nx, ny, nz, nxg, nyg, nzg
    real(dp), intent(out) :: S4(nxg,nyg,nzg), S5(nxg,nyg,nzg), S6(nxg,nyg,nzg)
    real(dp), intent(in)  :: U(nx,nyg,nzg), V(nxg,ny,nzg), W(nxg,nyg,nz)
    real(dp), intent(in)  :: x(nx), y(ny), z(nz), xg(nxg), yg(nyg), zg(nzg)
    integer :: i, j, k

    i = 2 + (blockIdx%x - 1)*blockDim%x + threadIdx%x - 1
    j = 2 + (blockIdx%y - 1)*blockDim%y + threadIdx%y - 1
    k = 2 + blockIdx%z - 1
    if (i > nxg .or. j > nyg .or. k > nzg) return

    S4(i,j,k) = 0.5_dp * ((U(i-1,j,k)-U(i-1,j-1,k))/(yg(j)-yg(j-1)) &
                        + (V(i,j-1,k)-V(i-1,j-1,k))/(xg(i)-xg(i-1)))
    ! W is z-faced (nz planes): k-1 <= nzg-1 = nz, always in bounds
    S5(i,j,k) = 0.5_dp * ((U(i-1,j,k)-U(i-1,j,k-1))/(zg(k)-zg(k-1)) &
                        + (W(i,j,k-1)-W(i-1,j,k-1))/(xg(i)-xg(i-1)))
    S6(i,j,k) = 0.5_dp * ((V(i,j-1,k)-V(i,j-1,k-1))/(zg(k)-zg(k-1)) &
                        + (W(i,j,k-1)-W(i,j-1,k-1))/(yg(j)-yg(j-1)))

  end subroutine k_sij_edges

  !--------------------------------------------------------------------
  ! k_smag_nut — compute_Sij diagonal + edge->center moves + |S|, then
  ! nu_t = (Cs*Delta*f)^2 * |S| (sgs_Smagorinsky Part 2), interior only.
  ! |S| accumulates in the reference's component order:
  !   2*s1^2 + 2*s2^2 + 2*s3^2 + 4*s4^2 + 4*s5^2 + 4*s6^2, then sqrt.
  !--------------------------------------------------------------------
  attributes(global) subroutine k_smag_nut(nut, S4, S5, S6, U, V, W, &
       coef, x, y, z, nx, ny, nz, nxg, nyg, nzg)
    integer, value :: nx, ny, nz, nxg, nyg, nzg
    real(dp), intent(out) :: nut(nxg,nyg,nzg)
    real(dp), intent(in)  :: S4(nxg,nyg,nzg), S5(nxg,nyg,nzg), S6(nxg,nyg,nzg)
    real(dp), intent(in)  :: U(nx,nyg,nzg), V(nxg,ny,nzg), W(nxg,nyg,nz)
    real(dp), intent(in)  :: coef(nyg)
    real(dp), intent(in)  :: x(nx), y(ny), z(nz)
    integer  :: i, j, k
    real(dp) :: s1, s2, s3, s4c, s5c, s6c, SS

    i = 2 + (blockIdx%x - 1)*blockDim%x + threadIdx%x - 1
    j = 2 + (blockIdx%y - 1)*blockDim%y + threadIdx%y - 1
    k = 2 + blockIdx%z - 1
    if (i > nxg-1 .or. j > nyg-1 .or. k > nzg-1) return

    ! diagonal Sij at cell centers
    s1 = (U(i,j,k) - U(i-1,j,k))/(x(i)-x(i-1))   ! dU/dx
    s2 = (V(i,j,k) - V(i,j-1,k))/(y(j)-y(j-1))   ! dV/dy
    s3 = (W(i,j,k) - W(i,j,k-1))/(z(k)-z(k-1))   ! dW/dz

    ! off-diagonal: cell edge -> cell center averages
    s4c = 0.25_dp * (S4(i,j,k) + S4(i+1,j,k) + S4(i,j+1,k) + S4(i+1,j+1,k))
    s5c = 0.25_dp * (S5(i,j,k) + S5(i+1,j,k) + S5(i,j,k+1) + S5(i+1,j,k+1))
    s6c = 0.25_dp * (S6(i,j,k) + S6(i,j+1,k) + S6(i,j,k+1) + S6(i,j+1,k+1))

    ! |S| = sqrt(2*Sij*Sij), reference component order 1..6
    SS = 2.0_dp*s1*s1
    SS = SS + 2.0_dp*s2*s2
    SS = SS + 2.0_dp*s3*s3
    SS = SS + 4.0_dp*s4c*s4c
    SS = SS + 4.0_dp*s5c*s5c
    SS = SS + 4.0_dp*s6c*s6c
    SS = SS**0.5_dp

    nut(i,j,k) = coef(j) * SS

  end subroutine k_smag_nut

  !--------------------------------------------------------------------
  ! k_avg_nut — per-j wall-parallel average over the local interior,
  ! serial per thread in the reference's memory order (i fastest, then
  ! k): avg(j) = Sum(nu_t(2:nxg-1, j, 2:nzg-1)) / ((nxg-2)*(nzg-2)).
  ! Deterministic (fixed order, no atomics).
  !--------------------------------------------------------------------
  attributes(global) subroutine k_avg_nut(avg, nut, nxg, nyg, nzg)
    integer, value :: nxg, nyg, nzg
    real(dp), intent(out) :: avg(nyg)
    real(dp), intent(in)  :: nut(nxg,nyg,nzg)
    integer  :: i, j, k
    real(dp) :: s

    j = 2 + (blockIdx%x - 1)*blockDim%x + threadIdx%x - 1
    if (j > nyg-1) return

    s = 0.0_dp
    do k = 2, nzg-1
       do i = 2, nxg-1
          s = s + nut(i,j,k)
       end do
    end do
    avg(j) = s / real( (nxg-2)*(nzg-2), dp )

  end subroutine k_avg_nut

#ifdef DEBUG_KERNELS
  subroutine debug_check(name)
    character(*), intent(in) :: name
    integer :: istat
    istat = cudaGetLastError()
    if (istat /= cudaSuccess) then
       write(*,*) 'KERNEL ERROR ', name, ': ', cudaGetErrorString(istat)
       error stop 'kernel launch failure (les_mod)'
    end if
  end subroutine debug_check
#else
  subroutine debug_check(name)
    character(*), intent(in) :: name
  end subroutine debug_check
#endif

end module les_mod
