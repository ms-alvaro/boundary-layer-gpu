! This is a template file to specify the input parameters of the code
! NOTE: you can add all comments you want, they must be followed by a "!" symbol.
! comments can be added after variables declaration
!
! Mandatory arguments are designated with (*) 

! Define the number of points in the domain (nx_global, ny_global, nz_global)
nxyz = 1142 180 34 ! (*)
! Define CFL number or time step (if negative)
CFL = -1e-4 ! (*)

nu = 4.436253367443143e-06 ! (*) viscosity of the flow

! Time integration scheme 
!   1 -> Euler, 
!   2 -> RK2 
!   3 -> RK3
RKscheme = 2 ! (*)

! Define subgrid scale model LES model 
!   0 -> no model 
!   1 -> constant smagorinsky 
!   2 -> DSM
LES = 0 ! (*)

! Define the wall model
!   0 -> no model 
!   1 -> momentum 
!   2 -> Bose 
!   3 -> fitting 
!   4 -> momentum wall 
!   5 -> constant alpha 
!   6 -> log 
!   7 -> momentum wall dyn 
!   8 -> log-f
!   9 -> ?????
WM = 0 ! (*)

! Additional arguments IF WM is 9
! for wall model 9: 0->fixed viscous fraction, 2->dynamic viscous fraction and viscous fraction
!WMnutflag = 0 -> fixed viscous fraction / 2 -> dynamic viscous fraction 
!WMnut = 0.05 -> dynamic viscous fraction (float number)

! Pressure gradients dPdx, dPdz
dPdx = 0.0 ! (*)
dPdz = 0.0 ! (*)

! Boundary condition for the top wall
!   0 -> impose velocity
!   1 -> Coleman2018
!   2 -> Abe2017
!   3 -> Falkner-Skan
!   4 -> zero shear: du/dy = dw/dy = 0 and v = V_top, the steady displacement
!        velocity (potential flow of the plate displacement with x_le)
top_flag = 1 ! (*)

! Potential-flow matching at the top (optional, needs top_flag = 4).
! The fluctuation about the steady potential flow is matched to an
! irrotational field that decays above y = Ly: d/dy q = -|k| q for every
! top-plane mode (kx, kz) and q = u, v, w (the "asymptotic" condition of
! Lundbladh et al. and Brandt, Schlatter & Henningson 2004). Discretely the
! lid value is the interior value times r, the per-cell decay factor of a
! potential mode of the solver's Laplacian, so displacement-thickness
! fluctuations no longer force a span-uniform change of the free-stream
! velocity. x uses the cosine basis of the pressure solve (rows extended
! evenly about the inlet and outlet planes), z is periodic.
!   0 or absent -> off (top_flag = 4 exactly as before; the sub-keys below are
!        then inert and may not be given)
!   1 -> all modes (production value)
!   2 -> only the spanwise-uniform modes kz = 0; kz /= 0 keep top_flag = 4
! top_potential = 1
!   top_potential_long: the spanwise-uniform lid modes with kx Ly < 1 (m = 0..10
!       in a box with Lx/Ly = 32; the (0,0) mode is one of them). A box with a
!       pinned inlet flux cannot host their unbounded response: a lid-flux
!       change on them comes back through the outlet mass correction as a
!       box-wide u' with gain Lx/(m pi Ly), and the free-stream turbulence under
!       the lid has a plane-mean v' residual on them (u'/sqrt(N_eddies)) that
!       evolves on the box-transit time, so no time filter removes it.
!       0 or absent -> they keep the top_flag = 4 lid (v = V_top, zero shear);
!            everything with k Ly >= 1 is matched. Production value.
!       1 -> matched like every other mode ((0,0) per top_potential_flux)
!       2 -> as 1 with the relaxation top_potential_tau (removes only the fast
!            part of the residual)
!   top_potential_vmean = FILE -> row dV(1:nxg) added to the lid row V_top (V
!       centres, ghosts included; stream binary int32 20261010, int32 nxg,
!       float64 dV): the steady mean excess transpiration of the actual layer,
!       d(U_e delta* - delta*_lam)/dx from the statistics of a previous run
!       (tools/make_top_vmean.py). With top_potential_long = 0 the pinned lid
!       flux then carries the layer's mean displacement growth and the mean
!       free stream stays at zero pressure gradient (without it the net excess
!       transpiration leaves through the outlet: U_e rising to +2.8 % in case A).
!   top_potential_flux (with top_potential_long >= 1): the (0,0) mode of the lid. 1 or absent -> dv/dy = 0
!       for the x-z mean (the k -> 0 limit of the condition): the total lid
!       flux is free, the net excess displacement of the layer leaves through
!       the lid, the outlet mass correction absorbs it and the mean free
!       stream keeps a zero pressure gradient. 0 -> the mean keeps v = V_top
!       (fixed total lid flux), for comparison only: in a long box it forces
!       the excess transpiration out of the outlet and amplifies the lowest
!       lid modes into box-wide free-stream velocity changes.
!   top_potential_tau (with top_potential_long = 2): relaxation time (default 0.5) of the long-wave
!       lid modes, the spanwise-uniform modes with kx Ly < 1 (m = 0..10 in a
!       box with Lx/Ly = 32). A lid-flux change on those modes is returned by
!       the outlet mass correction as a box-wide u' with gain Lx/(m pi Ly),
!       and the free-stream turbulence under the lid has a plane-mean v'
!       residual on them (u'_rms/sqrt(N_eddies), decorrelating on the eddy
!       passage time). The relaxation holds that fast residual back while the
!       steady net displacement flux and the slow displacement response
!       (>= 1 t.u.) pass. The filter state is written with every restart
!       snapshot to <snapshot>.topbc and read back at a restart.
!   top_potential_ref = FILE -> optional reference row Uref (top-cell row,
!       U faces) of a steady laminar solution of the same grid computed with
!       the old lid (tools/make_top_reference.py); that steady state is then
!       preserved exactly. Absent: the analytic potential flow of the Blasius
!       displacement (pot_le), which differs from the discrete laminar top
!       row by about 2e-4 in U (laminar Cf changes by at most 0.2 %).

! If top_flag is 1 or 2 we have to define additional inputs. Their definition 
! can be found in eq (2.1) of Coleman et al 2018, JFM vol 847 pp 28-70 / or in
! eq (2.1) in Abe 2017, JFM vol 833, pp 563-598.
Vmax = 0.3 ! maximum vertical velocity
x0 = 0     ! xc in Abe, streamwise position at which we pass from blowing to suction.
           ! Recall that the domain starts at x = 1 !!!
sigma = .3 ! std of the gaussian shape (sigma in the eqs)
phi = .003 ! This is phi_top in coleman2018 and psi in abe2017

! Define the number of steps to run, save, etc...
nsteps   = 1000000  ! (*) total steps for simulation
nsave    = 100000   ! (*) save a flow field
nstats   = 10000    ! (*) save a file with statistics
nmonitor = 1000     ! (*) info in the output file

! Start simulation from a random field
!   0 -> No, we need to specify a input file
!   1 -> Yes, a random initial condition is generated
! NOTE: if init_rand is not given, a value 0 is assigned
init_rand = 0 ! (*)

! If init_rand = 0 -> we must specify an input file:
filein = ../BL.00070000
! IMPORTANT: strings cannot have quotes!!
!   filein = ../BL.00070000    OK
!   filein = '../BL.00070000'  ERROR

! If init_rand = 1 -> we must specify the fluid domain:
! Lx, Ly, Lz, stret_factor (in y direction)
boxsize = 6.283185307179586 2.0 3.141592653589793 1d0
! NOTE: if stret_factor = 1d0 -> uniform mesh in y direction

init_step = 10 ! first number for output flow field (default is 0)

! Prefix name for the output flow field file
fileout = ../BLnew ! (*)


! Inflow bounday condition 
!   1 -> generate Blasius, 
!   2 -> Read from file, 
!   3 -> Lund's rescaling, 
!   4 -> Blasius+random, 
!   5 -> Lund's rescaling fluctuations
inflow_flag = 5 ! (*)

! In case inflow_flag > 1, we have to specify the inflow:
inflow_file = Mean_profile_Retheta1100_ny180_Ly0.4.dat
! inflow: time dependent component
timeinflow_file = **TO DO**

! if inflow_flag is 3 or 5:
Lund_ix = 129           ! streamwise plane for re-scaling ( grid index )
Lund_deltai = 3.0E-002  ! delta at the inlet
Lund_T = 0.5            ! rescaling time

! BC for eddy vicosity: 
!   0 -> Neumann
!   1 -> Dirichlet, 
nutBC = 1 !(*)

! Model to compute wall stress: 
!   0 -> use utau_ref, 
!   1 -> law-of-the-wall
TauwModel = 0

**TO DO**
!! Amplitude for random inflow perturbations
! 0
!! Hartree parameter for Falkner-Skan
! 0

! ---------------------------------------------------------------------------
! Leading edge inside the domain (optional). Without x_le the solver behaves
! exactly as before.
!   x_le    : streamwise position of the leading edge of a zero-thickness plate.
!             Bottom boundary for x < x_le is a free-slip symmetry plane, for
!             x >= x_le a no-slip plate. The inlet mean is uniform plus the
!             potential-flow correction of the plate displacement, and the
!             Blasius IC and the top-boundary displacement are measured from x_le.
!   le_open : 1 -> open bottom upstream of x_le (needs inflow_flag = 6, HIT).
!             The mean stays symmetric. The fluctuations crossing y = 0 are the
!             unmirrored HIT planes delayed by tau = (x - x_inlet)/U_inf (Taylor).
!             The net volume flux through the open patch is removed every step.
!   le_ramp : n > 0 -> regularised leading edge. Over the n cells before x_le the
!             ghost factor goes linearly from free slip to no slip and the
!             open-bottom HIT weight from 1 to 0. 0 -> sharp edge.
! x_le = 1.3504349615
! le_open = 1
! le_ramp = 8

! 3-D snapshots (optional), single precision, strided in x and z, full y:
!   snap3d_every  : steps between snapshots (0 -> off)
!   snap3d_stride : stored stride in x and z (packed on the GPU, gathered on rank 0)
!   snap3d_dir    : output directory (must exist). Grid in snap_grid.bin.
! snap3d_every = 10
! snap3d_stride = 3
! snap3d_dir = ./snapshots
